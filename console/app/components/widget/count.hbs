    <h3 class="text-sm dark:text-gray-100 text-black mb-4 {{@options.titleClass}}">{{this.title}}</h3>
    <h1 class="text-3xl font-bold dark:text-gray-100 text-black {{@options.valueClass}}">
        {{this.value}}
    </h1>
</div>
